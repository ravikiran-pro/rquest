PORT=3001
GOOGLE_MAPS_API_KEY=
LOCATIONIQ_API_KEY=

# ========================================================================
# OTP GATEWAY
# ========================================================================
# Core policy (all optional — sensible defaults shown)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Channel used when identifier is not an email and no channel is specified.
OTP_DEFAULT_CHANNEL=email
# DEV MODE: when true (default outside production) the API returns/logs the code,
# so you can test the full flow with NO provider keys and ZERO cost.
OTP_DEV_MODE=true

# ---- EMAIL (FREE) ------------------------------------------------------
# EMAIL_PROVIDER=brevo  -> https://www.brevo.com  (300 emails/day free)
# EMAIL_PROVIDER=resend -> https://resend.com     (3,000/mo, 100/day free)
EMAIL_PROVIDER=brevo
EMAIL_FROM=Rquest <no-reply@yourdomain.com>
BREVO_API_KEY=
RESEND_API_KEY=

# ---- SMS (FREE for dev) ------------------------------------------------
# SMS_PROVIDER=fast2sms -> https://www.fast2sms.com (₹50 free credit, India; DLT for prod)
# SMS_PROVIDER=twilio   -> https://www.twilio.com   (trial: 100 SMS, up to 5 verified numbers)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- WHATSAPP (FREE for dev: Meta Cloud API test number, up to 5 verified numbers) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set an approved "authentication" template name for production cold-sends.
# Leave empty in dev to send plain text inside an open 24h session.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US

# ---- TELEGRAM (FULLY FREE: bot from @BotFather; `to` is a numeric chat id) ----
TELEGRAM_BOT_TOKEN=
