# Copy to .env.catalog (git-ignored). The pipeline never reads the app's DB_* variables.
#
# Point this at a database where the `catalog` schema may be created. The pipeline
# only creates/changes objects inside `catalog`; it never touches `public`.
# For hard isolation in shared databases, use a role whose only write privilege is
# on the catalog schema (see README.md → "Database isolation").
CATALOG_DATABASE_URL=postgres://catalog_dev:catalog_dev@localhost:5432/rquest_catalog_test

# Where raw downloads are cached. Default: ~/.cache/rquest-catalog (outside the repo,
# so nodemon / Vite never see them).
# CATALOG_CACHE_DIR=

# Contact string sent in the User-Agent to open-data APIs (Open Food Facts asks for one).
# Use a generic project name or a team mailbox you are happy to share publicly.
# CATALOG_USER_AGENT=RquestCatalog/0.1 (catalog-pipeline)
